{
  "manifest_version": 3,
  "name": "arXiv 引用次数",
  "version": "0.2.0",
  "description": "在 arXiv 论文摘要页的标题右边显示引用次数。数据来自 OpenAlex，预印本和正式发表版本合并去重。",
  "permissions": ["storage"],
  "action": {
    "default_title": "arXiv 引用次数 · 设置",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://arxiv.org/abs/*", "https://www.arxiv.org/abs/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
